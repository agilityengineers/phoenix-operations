# ── Site ────────────────────────────────────────────────────────────────────
# Canonical URL used for SEO metadata, sitemap and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Postgres + Auth) ──────────────────────────────────────────────
# Leave unset to run in demo mode: an in-memory store seeded with the sample
# workspace/funnel/contacts, no login required for /admin.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=

# ── SendGrid (transactional email) ──────────────────────────────────────────
SENDGRID_API_KEY=
# Verified sender + internal notification recipient
SENDGRID_FROM_EMAIL=hello@phoenixoperations.com
OWNER_NOTIFICATION_EMAIL=joshua@phoenixoperations.com

# ── HubSpot (OAuth two-way sync) ────────────────────────────────────────────
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# OAuth redirect: ${NEXT_PUBLIC_SITE_URL}/api/integrations/hubspot/callback

# ── Zapier ──────────────────────────────────────────────────────────────────
# Shared token required on POST /api/webhooks/zapier/inbound
ZAPIER_INBOUND_TOKEN=

# ── Stripe (plans + trials) ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_PRACTICE=
STRIPE_PRICE_NETWORK=
